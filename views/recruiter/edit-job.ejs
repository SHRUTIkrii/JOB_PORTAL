<!DOCTYPE html>

<html>

<head>

    <title>Edit Job</title>

</head>


<body>

    <h1>Edit Job</h1>


    <form
        action="/edit-job/<%= job._id %>"
        method="POST"
    >


        <label>
            Job Title
        </label>

        <br>

        <input
            type="text"
            name="title"
            value="<%= job.title %>"
            required
        >

        <br><br>


        <label>
            Company
        </label>

        <br>

        <input
            type="text"
            name="company"
            value="<%= job.company %>"
            required
        >

        <br><br>


        <label>
            Location
        </label>

        <br>

        <input
            type="text"
            name="location"
            value="<%= job.location %>"
            required
        >

        <br><br>


        <label>
            Salary
        </label>

        <br>

        <input
            type="text"
            name="salary"
            value="<%= job.salary %>"
            required
        >

        <br><br>


        <label>
            Skills
        </label>

        <br>

        <input
            type="text"
            name="skills"
            value="<%= job.skills %>"
            required
        >

        <br><br>


        <label>
            Description
        </label>

        <br>

        <textarea
            name="description"
            rows="5"
            cols="40"
            required
        ><%= job.description %></textarea>

        <br><br>


        <button type="submit">
            Update Job
        </button>


    </form>


    <br>


    <a href="/recruiter">
        Back to Dashboard
    </a>


</body>

</html>