<!DOCTYPE html>

<html>

<head>

    <title>All Jobs</title>

</head>


<body>

    <h1>Available Jobs</h1>


    <a href="/recruiter">
        Recruiter Dashboard
    </a>

    <br><br>


    <a href="/">
        Home
    </a>


    <hr>


    <% if (jobs.length === 0) { %>

        <p>
            No jobs available.
        </p>

    <% } else { %>


        <% jobs.forEach(job => { %>

            <div>

                <h2>
                    <%= job.title %>
                </h2>


                <p>
                    <strong>Company:</strong>
                    <%= job.company %>
                </p>


                <p>
                    <strong>Location:</strong>
                    <%= job.location %>
                </p>


                <p>
                    <strong>Salary:</strong>
                    <%= job.salary %>
                </p>


                <p>
                    <strong>Skills:</strong>
                    <%= job.skills %>
                </p>


                <p>
                    <strong>Description:</strong>
                    <%= job.description %>
                </p>


                <% if (job.recruiter) { %>

                    <p>
                        <strong>Posted By:</strong>
                        <%= job.recruiter.name %>
                    </p>

                <% } %>


                <hr>

            </div>

        <% }) %>


    <% } %>


</body>

</html>